{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": { "fillOpacity": 15, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "adapter_watts" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [6, 6], "fill": "dash" } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "targets": [
        {
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mac_power\" and r.host == \"${host}\")\n  |> filter(fn: (r) => r._field == \"system_load_w\" or r._field == \"system_power_in_w\" or r._field == \"adapter_watts\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ],
      "title": "System Power Draw & Charger Capacity",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mac_power\" and r.host == \"${host}\")\n  |> filter(fn: (r) => r._field == \"battery_pct\" or r._field == \"health_pct\")",
          "refId": "A"
        }
      ],
      "title": "Battery & Health",
      "type": "stat"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 36 },
              { "color": "red", "value": 42 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 4 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mac_power\" and r.host == \"${host}\" and r._field == \"battery_temp_c\")",
          "refId": "A"
        }
      ],
      "title": "Battery Temperature",
      "type": "stat"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "targets": [
        {
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"cpu\" and r.host == \"${host}\" and r.cpu == \"cpu-total\" and r._field == \"usage_active\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ],
      "title": "CPU Usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "targets": [
        {
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mac_system\" and r.host == \"${host}\" and r._field == \"memory_free_pct\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ],
      "title": "macOS Memory Pressure (Free %)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 15 },
      "id": 6,
      "targets": [
        {
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mac_system\" and r.host == \"${host}\" and r._field == \"swap_used_mb\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ],
      "title": "Swap Used",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 3,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Nominal" }, "1": { "text": "Fair" }, "2": { "text": "Serious" }, "3": { "text": "Critical" } } }
          ],
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 20 }
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 15 },
      "id": 7,
      "targets": [
        {
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mac_system\" and r.host == \"${host}\" and (r._field == \"thermal_state\" or r._field == \"low_power_mode\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)",
          "refId": "A"
        }
      ],
      "title": "Thermal State & Low Power Mode",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["macos", "telegraf", "influxdb"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "influxdb",
        "current": {}
      },
      {
        "name": "bucket",
        "type": "textbox",
        "query": "system_metrics",
        "current": { "text": "system_metrics", "value": "system_metrics" }
      },
      {
        "name": "host",
        "type": "query",
        "datasource": { "type": "influxdb", "uid": "${datasource}" },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"host\", predicate: (r) => r._measurement == \"mac_system\")",
        "refresh": 1
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "title": "macOS Telemetry (mac-telegraf)",
  "uid": "mac-telegraf-overview",
  "version": 1
}
