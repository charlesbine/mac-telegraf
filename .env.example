# Copy to .env and fill in your InfluxDB v2 credentials.
# Keep .env private (gitignored) and use a bucket-scoped write token.

INFLUXDB_URL=https://influx.example.com
INFLUXDB_TOKEN=your-write-only-token
INFLUXDB_ORG=your-org
INFLUXDB_BUCKET=system_metrics

# Optional tags applied to every metric from this Mac
MAC_HOSTNAME=my-mac
MAC_HOST_ROLE=laptop
